<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HideArmor</AssemblyName>
    <RootNamespace>HideArmor</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EftGameDir>J:\SteamLibrary\steamapps\common\Escape from Tarkov</EftGameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(EftGameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(EftGameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(EftGameDir)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(EftGameDir)\EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(EftGameDir)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(EftGameDir)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(EftGameDir)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(EftGameDir)')">
    <MakeDir Directories="$(EftGameDir)\BepInEx\plugins\HideArmor" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EftGameDir)\BepInEx\plugins\HideArmor" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(EftGameDir)\BepInEx\plugins\HideArmor" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
